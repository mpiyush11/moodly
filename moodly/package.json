{
  "name": "moodly",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx tests/database.ts",
    "test:browser": "playwright test",
    "verify": "npm run typecheck && npm test && npm run test:db && npm run build",
    "test:api": "npm run test:development",
    "test:live": "tsx scripts/verify-live-request.ts",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "test:uploads": "tsx scripts/verify-uploads.ts",
    "postinstall": "node scripts/setup-env.mjs",
    "predev": "node scripts/setup-env.mjs && node scripts/setup-db.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:db": "node scripts/setup-db.mjs",
    "test:development": "tsx scripts/verify-development.ts",
    "test:development:browser": "npm run test:browser",
    "test:responsive": "node scripts/verify-responsive.mjs"
  },
  "dependencies": {
    "@next/env": "^15.5.27",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.28",
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
