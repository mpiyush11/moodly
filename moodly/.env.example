# Private production configuration. Development creates .env.local automatically.
MOODLY_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server access: either a private service-role key or a private DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Development-only password login; ignored in production.
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=
# Optional private database CA certificate for a different provider.
DATABASE_CA_CERT=
# Only for explicitly selected local JSON demo mode.
DEMO_ADMIN_EMAIL=studio@moodly.local
DEMO_ADMIN_PASSWORD=MoodlyStudio2026!
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
# Canonical public origin (private production domain) for a trusted reverse proxy.
NEXT_PUBLIC_SITE_URL=
# Optional exact origins only, comma separated. No wildcard preview domains.
MOODLY_TRUSTED_ORIGINS=
